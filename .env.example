# Copy to ".env" and fill in. Never commit the real .env.

# Groq - optional; without it agents run rule-based. Free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional tuning
# EQUITY_NEWS_LOOKBACK_DAYS=7
# EQUITY_MAX_HEADLINES=15
# EQUITY_WATCHLIST=equity_agents/watchlist.txt
# EQUITY_REPORTS_DIR=reports
